# Copy this file to .env and adjust the values. .env is not committed.
POSTGRES_DB=optifarmdb
POSTGRES_USER=optifarmuser
POSTGRES_PASSWORD=change-me
# Where the backend finds the database: optifarm-postgres for backend as a container in the same compose network,
# localhost for backend started with mvn spring-boot:run
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
JWT_SECRET=change-me-to-a-long-random-string